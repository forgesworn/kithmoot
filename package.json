{
  "name": "kithmoot",
  "version": "0.1.0",
  "description": "Multi-device conference rooms over Nostr - a town hall nobody owns",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build --config app/vite.config.ts",
    "build:lib": "tsc -p tsconfig.json",
    "demo": "vite --config app/vite.config.ts --host",
    "forwarder": "npm run build:lib && node server/forwarder.mjs",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts --testTimeout=40000",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "vectors": "npm run build:lib && node vectors/generate.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^2.0.0",
    "nostr-tools": "^2.25.0",
    "qrcode": "^1.5.4",
    "signet-login": "^0.14.2",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  },
  "bin": {
    "kithmoot-forwarder": "./server/forwarder.mjs"
  }
}
