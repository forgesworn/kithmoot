{
  "name": "kithmoot",
  "version": "0.3.0",
  "description": "An open Slack with agents over Nostr - a workspace nobody owns",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "bin",
    "server/forwarder.mjs",
    "vectors/kithmoot-vectors.json"
  ],
  "scripts": {
    "build": "npm run build:context && vite build --config app/vite.config.ts",
    "build:lib": "npm run build:context && tsc -p tsconfig.json",
    "prepack": "npm run build:lib",
    "demo": "vite --config app/vite.config.ts --host",
    "forwarder": "npm run build:lib && node server/forwarder.mjs",
    "pretest": "npm run build:lib",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts --testTimeout=40000",
    "test:e2e": "playwright test",
    "typecheck": "npm run build:context && tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "vectors": "npm run build:lib && node vectors/generate.mjs",
    "test:turn": "playwright test --config playwright.turn.config.ts",
    "agent": "npm run build:lib && node bin/kithmoot-agent.mjs",
    "build:context": "npm run build --workspace @forgesworn/context && npm run build --workspace @forgesworn/context-tools",
    "test:context-packages": "node test/context-package-smoke.mjs",
    "predemo": "npm run build:context"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@forgesworn/context": "0.1.0",
    "@forgesworn/context-tools": "0.1.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^2.0.0",
    "nostr-tools": "^2.25.0",
    "opus-decoder": "^0.7.12",
    "qrcode": "^1.5.4",
    "signet-login": "^0.14.3",
    "spoken-token": "^2.1.0",
    "werift": "^0.24.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "bin": {
    "kithmoot-context": "./bin/kithmoot-context.mjs",
    "kithmoot-forwarder": "./server/forwarder.mjs",
    "kithmoot-agent": "./bin/kithmoot-agent.mjs"
  },
  "workspaces": [
    "packages/context",
    "packages/context-tools"
  ]
}
