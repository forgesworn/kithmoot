# systemd unit for server/turn-credentials.mjs - the endpoint that mints
# time-limited TURN credentials for a browser joining a KithMoot room (see
# deploy/README.md and deploy/turn-credentials.md for the whole picture).
#
# INSTALL: deploy/turn-deploy.sh does all of this. It ships a minimal tree
# to /opt/kithmoot-turn (server/turn-credentials.mjs, the built
# dist/src/turn.js it imports, and the lockfile), and deploy/coturn/install.sh
# creates the kithmoot-turn user, writes the EnvironmentFile below, runs
# `npm ci --omit=dev`, and enables this unit.
#
# The tree at /opt/kithmoot-turn is shipped, not built in place: dist/ is
# gitignored and produced by `npm run build:lib` on the machine running the
# deploy, so there is no compiler on the box and nothing to rebuild there.
# Re-run deploy/turn-deploy.sh after any change to src/turn.ts or
# server/turn-credentials.mjs; nothing picks those up on its own.
#
# The EnvironmentFile is /etc/kithmoot/turn-credentials.env, mode 0600 owned
# by kithmoot-turn, and it holds TURN_SECRET. The secret is never in this
# unit file, which is world-readable via `systemctl cat`. It carries:
#   TURN_SECRET=<64 hex chars, matching static-auth-secret in coturn's config>
#   TURN_URLS=turn:host:3478,turn:host:3478?transport=tcp,turns:host:5349
#   TURN_TTL_SECONDS=3600
#   ALLOWED_ORIGINS=https://kithmoot.forgesworn.dev
#   PORT=8089
#
# Verify: `curl -s http://127.0.0.1:8089/healthz` prints `ok`, and
#   curl -s https://kithmoot.forgesworn.dev/turn \
#     -H 'Origin: https://kithmoot.forgesworn.dev'
# returns {"urls":[...],"username":"...","credential":"...","ttl":...}.
# That only proves the endpoint answers. deploy/README.md's "Verifying TURN
# actually works" section is the check that matters: a browser forced to
# iceTransportPolicy 'relay', which cannot connect by any route except
# through coturn.
# `journalctl -u turn-credentials -f` for logs (stderr only - see the
# "No console.log noise" note in server/turn-credentials.mjs).

[Unit]
Description=KithMoot TURN credential minting service
Documentation=file:///opt/kithmoot-turn/server/turn-credentials.mjs
After=network.target

[Service]
Type=simple
User=kithmoot-turn
Group=kithmoot-turn
WorkingDirectory=/opt/kithmoot-turn
EnvironmentFile=/etc/kithmoot/turn-credentials.env
ExecStart=/usr/bin/node server/turn-credentials.mjs
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

# Hardening: this process holds TURN_SECRET in memory and answers
# unauthenticated traffic proxied in from the public internet (see the
# security note at the top of server/turn-credentials.mjs) - it gets
# nothing beyond what it needs to listen on a loopback port and read its
# own tree.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# No MemoryDenyWriteExecute here, and it is not an oversight. V8 is a JIT:
# it writes machine code into a mapping and then executes it, which is
# exactly the sequence MDWE exists to forbid. With it set, node does not
# fail to listen or throw something catchable - it dies with a V8 fatal
# error inside GenerateBaselineCode the first time a function gets hot
# enough to tier up, so the service starts, answers for a few seconds and
# then crash-loops. Every other hardening directive above applies to a JIT
# process perfectly well; this one is incompatible with running Node at
# all.

[Install]
WantedBy=multi-user.target
