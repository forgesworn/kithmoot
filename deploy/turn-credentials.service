# systemd unit for server/turn-credentials.mjs - the endpoint that mints
# time-limited TURN credentials for a browser joining a KithMoot room (see
# deploy/README.md and deploy/turn-credentials.md for the whole picture).
#
# INSTALL:
#   1. Create a dedicated, unprivileged user with no shell and no home:
#        sudo useradd --system --no-create-home --shell /usr/sbin/nologin kithmoot-turn
#   2. Put a checkout of this repo somewhere that user can read, e.g.
#      /opt/kithmoot, and run `npm ci && npm run build:lib` in it. The
#      service imports src/turn.ts's built output (dist/src/turn.js) - see
#      the comment at the top of server/turn-credentials.mjs - and dist/ is
#      gitignored, so this is a step to repeat after every pull, not a
#      one-off. Nothing here rebuilds it automatically; re-run it (and
#      `systemctl restart turn-credentials`) after any update.
#        sudo chown -R kithmoot-turn:kithmoot-turn /opt/kithmoot
#   3. Create the secret and the EnvironmentFile it lives in - NEVER in
#      this unit file, which is world-readable via systemctl cat:
#        openssl rand -hex 32
#      Write /etc/kithmoot/turn-credentials.env, owned by that user and
#      readable by no one else:
#        TURN_SECRET=<the value from openssl rand above - must match
#                      static-auth-secret in deploy/coturn/turnserver.conf>
#        TURN_URLS=turn:turn.kithmoot.example:3478,turns:turn.kithmoot.example:5349
#        TURN_TTL_SECONDS=3600
#        ALLOWED_ORIGINS=https://kithmoot.example
#        PORT=8089
#      Then:
#        sudo mkdir -p /etc/kithmoot
#        sudo mv turn-credentials.env /etc/kithmoot/turn-credentials.env
#        sudo chown kithmoot-turn:kithmoot-turn /etc/kithmoot/turn-credentials.env
#        sudo chmod 600 /etc/kithmoot/turn-credentials.env
#   4. Edit WorkingDirectory below if the checkout isn't at /opt/kithmoot.
#   5. sudo cp deploy/turn-credentials.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now turn-credentials
#   6. Verify: `curl -s http://127.0.0.1:8089/healthz` should print `ok`,
#      and `curl -s http://127.0.0.1:8089/turn -H 'Origin: https://kithmoot.example'`
#      (only once Caddy is wired per deploy/Caddyfile.kithmoot, the same
#      check works against the public /turn path) should return
#      {"urls":[...],"username":"...","credential":"...","ttl":...}. Then
#      follow deploy/README.md's "Verifying TURN actually works" section
#      with a trickle-ICE tester to confirm a browser actually gets a
#      relay candidate, not just that this endpoint answers.
#      `journalctl -u turn-credentials -f` for logs (stderr only - see the
#      "No console.log noise" note in server/turn-credentials.mjs).

[Unit]
Description=KithMoot TURN credential minting service
Documentation=file:///opt/kithmoot/deploy/turn-credentials.md
After=network.target

[Service]
Type=simple
User=kithmoot-turn
Group=kithmoot-turn
WorkingDirectory=/opt/kithmoot
EnvironmentFile=/etc/kithmoot/turn-credentials.env
ExecStart=/usr/bin/node server/turn-credentials.mjs
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

# Hardening: this process holds TURN_SECRET in memory and answers
# unauthenticated traffic proxied in from the public internet (see the
# security note at the top of server/turn-credentials.mjs) - it gets
# nothing beyond what it needs to listen on a loopback port and read its
# own checkout.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
