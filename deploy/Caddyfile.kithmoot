# kithmoot.forgesworn.dev - the page at the root, the PWA at /j, the APKs at
# /apk. Served from /var/www/kithmoot/current on the shared "stall" box.
#
# Install: additive conf.d drop-in, imported by the main Caddyfile's
# `import /etc/caddy/conf.d/*.Caddyfile`. Copy this to
# /etc/caddy/conf.d/kithmoot.forgesworn.dev.Caddyfile - the .Caddyfile
# suffix is what the glob matches - and never touch another tenant's
# directory, unit or vhost. Validate, then reload:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Run deploy/deploy.sh at least once first, so /var/www/kithmoot/current
# exists: an absent root is a startup error, not a soft 404.
#
# Auto-TLS: the A record is grey-cloud (DNS-only) to this origin, so Caddy
# issues and renews the Let's Encrypt certificate itself.
kithmoot.forgesworn.dev {
	root * /var/www/kithmoot/current
	encode zstd gzip

	# TURN credential minting (server/turn-credentials.mjs, installed as
	# deploy/turn-credentials.service, listening on 127.0.0.1:8089). Live
	# together with TURN_CREDENTIAL_ENDPOINT in app/src/main.ts: this path
	# and that constant are switched on as a pair, never one without the
	# other. A reverse_proxy to a port nothing is listening on is a 502 for
	# anyone who finds the path, and the constant without this path is an
	# app that fetches a 404 on every join.
	#
	# Only /turn is proxied. /healthz is deliberately not exposed publicly:
	# it exists for `curl http://127.0.0.1:8089/healthz` on the box, and
	# publishing it would only advertise the service to anyone scanning.
	#
	# The endpoint is not authenticated. Anyone who finds this URL can mint
	# a credential and relay media through coturn at this box's expense.
	# The service's own per-IP rate limiter and its ALLOWED_ORIGINS check
	# are what stand in the way, plus coturn's user-quota, total-quota and
	# bps-capacity, which cap what a minted credential can actually consume
	# even when one is obtained. See the security note at the top of
	# server/turn-credentials.mjs: none of that is a substitute for real
	# access control, and it is a deliberate, documented trade.
	# A `handle` block, not a bare matched `reverse_proxy`. Caddy sorts
	# directives by its own fixed order rather than by their position in the
	# file, and `handle` sorts ahead of `reverse_proxy` - so the catch-all
	# `handle { file_server }` below would match /turn first and answer 404,
	# with this line never reached. Inside a handle block of its own, placed
	# before the catch-all, it is part of the same mutually exclusive group
	# and wins on the more specific path.
	handle /turn {
		reverse_proxy 127.0.0.1:8089
	}

	# The APKs live outside the release directories, so a rollback of the
	# site does not take the downloads with it and a redeploy does not
	# re-upload 50 MB.
	handle /apk/* {
		root * /var/www/kithmoot
		# No `browse`: the page links a stable filename, and a directory
		# listing is Caddy-generated HTML with inline style and script that
		# the strict CSP below would break anyway.
		file_server
	}

	handle {
		file_server
	}

	# --- headers -------------------------------------------------------
	#
	# Content-Security-Policy and Permissions-Policy are set by two blocks
	# with *disjoint* matchers, never by a base block that a later one
	# overrides. A base `header` block containing `-Server` or a `?` set is
	# deferred by Caddy to response-write time, so it runs after every
	# matched block regardless of where it sits in this file - and would
	# quietly put the marketing page's `default-src 'none'` back on the app,
	# which loads as a blank page with the camera disabled. Disjoint
	# matchers make that failure impossible rather than merely unlikely.

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?Cache-Control "no-cache"
	}

	@app path /j /j/*
	header @app {
		# KithMoot is a WebRTC application. camera, microphone and
		# display-capture have to be granted to this origin or getUserMedia
		# and getDisplayMedia fail before any of the rest of it matters -
		# and they fail quietly, which is the worst kind.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		# Derived from what app/src/main.ts actually does, and no wider:
		#
		#   script-src 'self' 'wasm-unsafe-eval' - one bundled module, no
		#     inline script, and the MediaPipe segmenter is WebAssembly
		#     served from this origin (app/vite.config.ts). Without
		#     'wasm-unsafe-eval' Chromium refuses to compile it: the SIMD
		#     probe fails, the loader asks for the nosimd variant, and the
		#     effect dies into its passthrough fallback - silently, because
		#     a broken effect must not end a call. There is no narrower
		#     grant: 'wasm-unsafe-eval' is CSP's only switch for WASM, and
		#     the modules it admits still come only from 'self'.
		#   style-src ... 'unsafe-inline' - signet-login builds its signer
		#     picker by creating a <style> element and setting cssText
		#     (node_modules/signet-login/dist/modal.js). Without this the
		#     sign-in modal renders unstyled. Nothing in this repo needs it.
		#   img-src ... https: - a kind-0 profile picture is an arbitrary
		#     URL belonging to whoever published it (app/src/profiles.ts).
		#   connect-src ... wss: - relays. A room carries its own relay
		#     list in the join link, so no fixed list can be right here.
		#     https: is for the TURN credential endpoint above.
		#   media-src ... blob: mediastream: - remote tracks are attached
		#     by srcObject, which CSP does not police, but the QR canvas
		#     and any future recording path do go through URLs.
		#   worker-src 'self' - the service worker at /j/sw.js.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: mediastream:; connect-src 'self' wss: https:; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# Everything that is not the app: the marketing page, which is HTML, CSS
	# and three WebP images with no script of any kind, and the APK
	# downloads, which are bytes.
	@notApp not path /j /j/*
	header @notApp {
		Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# --- caching -------------------------------------------------------

	# Everything under /j/assets/ is content-hashed by the Vite build, so
	# the filename changes whenever the bytes do.
	@immutable path /j/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# A cached sw.js is a cached old version of the whole app that can
	# never see the new one, because the old worker is the thing that
	# decides whether to fetch a replacement. index.html carries the hashed
	# asset URLs for the current build and needs the same treatment.
	@noCache path /j/sw.js /j/index.html /j/ /j /j/manifest.webmanifest
	header @noCache Cache-Control "no-cache, no-store, must-revalidate"

	# An APK filename carries its version, so a given file never changes.
	@apk path /apk/*.apk
	header @apk Cache-Control "public, max-age=604800"

	# No access logs, matching every other conf.d drop-in on this box
	# (cambium, flock, farrier-kit, heartwood, meatchat) and matching what
	# the page claims: a relay carrying a room cannot read its guest list,
	# and the host serving the page keeps no record of who asked for it.
	#
	# It also avoids a trap. `sudo caddy validate` runs as root and creates
	# any log file the config names, owned by root; the caddy user then
	# cannot open it and every subsequent reload fails with a permission
	# error on a file nobody remembers creating.
	log {
		output discard
	}
}
