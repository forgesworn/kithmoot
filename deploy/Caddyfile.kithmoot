# kithmoot.app and kithmoot.forgesworn.dev, from one release directory.
#
#   kithmoot.app            the website, the downloads page and the APKs.
#                           /j redirects to the app on kithmoot.forgesworn.dev.
#   www.kithmoot.app        redirects to kithmoot.app.
#   kithmoot.forgesworn.dev the PWA at /j, the APKs at /apk, TURN credentials,
#                           the drop tier, Blossom, and the desktop update
#                           feed. Its website pages redirect to kithmoot.app.
#
# Both serve /var/www/kithmoot/current on the shared "stall" box.
#
# The app stays on kithmoot.forgesworn.dev until it is moved on purpose. A
# room link is written from the origin the app runs on, a browser keeps a
# visitor's rooms and identity per origin, the desktop clients pin this
# origin, and kithmoot.app is proxied by Cloudflare, whose request-size cap
# is below the 270 MiB a Blossom upload may need. Moving the app is all of
# those at once, not a DNS change.
#
# Install: additive conf.d drop-in, imported by the main Caddyfile's
# `import /etc/caddy/conf.d/*.Caddyfile`. Copy this to
# /etc/caddy/conf.d/kithmoot.forgesworn.dev.Caddyfile - the .Caddyfile
# suffix is what the glob matches - and never touch another tenant's
# directory, unit or vhost. Validate, then reload:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Run deploy/deploy.sh at least once first, so /var/www/kithmoot/current
# exists: an absent root is a startup error, not a soft 404.
#
# Auto-TLS: kithmoot.forgesworn.dev's A record is grey-cloud (DNS-only) to
# this origin. kithmoot.app is orange-cloud, like the other proxied sites on
# this box; Cloudflare passes the ACME HTTP challenge through, so Caddy
# issues and renews both certificates itself.

# Shared by both website hosts. Snippet names are global across every
# conf.d drop-in, hence the prefix.
(kithmoot_pages) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?Cache-Control "no-cache"
	}

	# The downloads page runs one script of its own, downloads.js, which
	# picks the installer for the visitor's computer and reads versions.json
	# for the version picker. Same origin only; it sends nothing anywhere.
	@downloads path /downloads /downloads/*
	header @downloads {
		Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# The marketing page uses a native GET form to hand a room code to the
	# app; no script, lookup or microphone/camera request happens here.
	# All other website pages and APK downloads share these restrictions.
	@notApp {
		not path /j /j/*
		not path /downloads /downloads/*
		not path /camera-lab /camera-lab/*
	}
	header @notApp {
		Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action https://kithmoot.forgesworn.dev/j/; frame-ancestors 'none'"
	}

	# Versioned APKs never change. The moving latest link must be re-fetched.
	@apk {
		path /apk/*.apk
		not path /apk/kithmoot-latest.apk
	}
	header @apk Cache-Control "public, max-age=604800"
	@apkLatest path /apk/kithmoot-latest.apk
	header @apkLatest Cache-Control "no-cache, no-store, must-revalidate"
}

# Separate read-only preview: models/assets download; capture stays on-device.
# Its root is outside app releases so publishing a lab never changes a call.
(kithmoot_camera_lab) {
	redir /camera-lab /camera-lab/ 308
	@cameraLab path /camera-lab /camera-lab/*
	header @cameraLab {
		Permissions-Policy "camera=(self), microphone=(self)"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Cache-Control "no-store"
	}
	handle_path /camera-lab/* {
		root * /var/www/kithmoot/vision-lab/current
		@cameraLabRead method GET HEAD
		route {
			file_server @cameraLabRead
			respond "Read-only Camera Lab" 405
		}
	}
}

kithmoot.forgesworn.dev {
	root * /var/www/kithmoot/current
	encode zstd gzip
	import kithmoot_camera_lab

	# TURN credential minting (server/turn-credentials.mjs, installed as
	# deploy/turn-credentials.service, listening on 127.0.0.1:8089). Live
	# together with TURN_CREDENTIAL_ENDPOINT in app/src/main.ts: this path
	# and that constant are switched on as a pair, never one without the
	# other. A reverse_proxy to a port nothing is listening on is a 502 for
	# anyone who finds the path, and the constant without this path is an
	# app that fetches a 404 on every join.
	#
	# Only /turn is proxied. /healthz is deliberately not exposed publicly:
	# it exists for `curl http://127.0.0.1:8089/healthz` on the box, and
	# publishing it would only advertise the service to anyone scanning.
	#
	# The endpoint is not authenticated. Anyone who finds this URL can mint
	# a credential and relay media through coturn at this box's expense.
	# The service's own per-IP rate limiter and its ALLOWED_ORIGINS check
	# are what stand in the way, plus coturn's user-quota, total-quota and
	# bps-capacity, which cap what a minted credential can actually consume
	# even when one is obtained. See the security note at the top of
	# server/turn-credentials.mjs: none of that is a substitute for real
	# access control, and it is a deliberate, documented trade.
	# A `handle` block, not a bare matched `reverse_proxy`. Caddy sorts
	# directives by its own fixed order rather than by their position in the
	# file, and `handle` sorts ahead of `reverse_proxy` - so the catch-all
	# `handle { file_server }` below would match /turn first and answer 404,
	# with this line never reached. Inside a handle block of its own, placed
	# before the catch-all, it is part of the same mutually exclusive group
	# and wins on the more specific path.
	handle /turn {
		reverse_proxy 127.0.0.1:8089
	}

	# Meeting codes (server/meeting-codes.mjs, installed as
	# deploy/meeting-codes.service, listening on 127.0.0.1:8114 because
	# 8093 is the Tor front at the bottom of this file and other tenants
	# on the box hold 8094 to 8100). POST /codes and
	# GET, PUT and DELETE /codes/<code>; the service answers 404 to anything
	# else under the prefix. See docs/meeting-codes.md for the trust model:
	# the service stores full invitation links, or for a code with a
	# password an envelope it cannot open without the words.
	#
	# /codes/health is not forwarded, as /healthz is not for /turn: it is
	# for `curl http://127.0.0.1:8114/codes/health` on the box. Here it
	# falls through to the file server's 404 (and the service answers 404 to
	# a health check carrying X-Forwarded-For, should it ever arrive).
	#
	# The service's per-address limits trust only the last X-Forwarded-For
	# entry, the one reverse_proxy appends. That is the visitor's own
	# address because this host is grey-cloud (no Cloudflare in front) and
	# no trusted_proxies is configured, so Caddy discards any
	# X-Forwarded-For the client sent. Putting this host behind a proxy
	# would turn every visitor into the proxy's address, one shared budget.
	#
	# A `handle` block before the catch-all, for the ordering reason given
	# on /turn above.
	@codes {
		path /codes*
		not path /codes/health
	}
	handle @codes {
		reverse_proxy 127.0.0.1:8114
	}

	# No /drops here. The box's drop tier (bothy-node, container
	# `bothyd-stall`) took kind 1059 gift wraps from anyone, and was fronted
	# at wss://kithmoot.forgesworn.dev/drops until 21 October 2026. It is
	# no longer fronted: nothing on this host takes content from whoever
	# finds it. The tier itself still listens on 127.0.0.1:4848, because
	# the box's cadence work will not start without it; it is reachable
	# only from the box. A request for /drops falls through to the
	# catch-all below and gets a 404.

	# Blossom (BUD-01), for the files dropped into a room's chat. The app's
	# BLOSSOM_ENDPOINT is this origin and nothing more, because an upload
	# authorisation names a host and BUD-01 puts the upload at /upload under
	# it: so /upload is proxied at the root, and the blobs are served under
	# /blossom/, which is the base the service is told (BLOSSOM_PUBLIC_URL)
	# to name in the descriptor it answers an upload with.
	# kithmoot-blossom.service listens on 127.0.0.1:8092; see deploy/README.md,
	# "Running a Blossom server". Like /turn and its constant, these two
	# handles and BLOSSOM_ENDPOINT are switched on together.
	#
	# The 270 MiB is the per-blob cap, and this is where it lives: a 256 MiB
	# source (MAX_UPLOAD_SOURCE_BYTES, refused by the app before sealing) plus
	# the envelope's padding and tags, since blossom-server-ts has no cap of
	# its own. Caddy reads the body up to that and no further: the request is
	# answered 413, the upstream is cut, and the service removes its spool.
	# (It does not pre-check the Content-Length, so an over-cap upload costs
	# 270 MiB of transfer before it is refused; the app never sends one.)
	# Only PUT and HEAD (BUD-06's preflight) reach the service at
	# /upload, and only GET, HEAD and DELETE reach a hash-shaped path under
	# /blossom/, the prefix stripped as for a fetch; OPTIONS on both so a
	# Blossom client on another origin can preflight. The DELETE is BUD-02's:
	# the service honours it only with a signed `t` delete authorisation from
	# the key that uploaded the blob (a room's device key, which names
	# nobody), and with `removeWhenNoOwners` in blossom.yml the bytes go with
	# it. Any other key is answered 200 and nothing changes. A list, a
	# mirror, the admin page or the landing page falls through to the file
	# server and its 404.
	@blossomUpload {
		path /upload
		method PUT HEAD OPTIONS
	}
	handle @blossomUpload {
		request_body {
			max_size 270MiB
		}
		reverse_proxy 127.0.0.1:8092
	}
	@blossomBlob {
		path_regexp ^/blossom/[0-9a-f]{64}(\.[a-z0-9]{1,10})?$
		method GET HEAD DELETE OPTIONS
	}
	handle @blossomBlob {
		uri strip_prefix /blossom
		reverse_proxy 127.0.0.1:8092
	}

	# The website lives at kithmoot.app now. Only its pages move: the app,
	# the APKs, the endpoints above, the desktop update feed under
	# /downloads/updates/, versions.json and the root icons the app loads
	# all keep answering here. An allowlist, not "everything but", so a
	# path nobody thought of keeps working instead of leaving.
	@movedPages path / /index.html /downloads /downloads/ /downloads/index.html /terms /terms/ /terms/index.html /privacy /privacy/ /privacy/index.html /report /report/ /report/index.html
	redir @movedPages https://kithmoot.app{uri} 301

	# The APKs live outside the release directories, so a rollback of the
	# site does not take the downloads with it and a redeploy does not
	# re-upload 50 MB.
	handle /apk/* {
		root * /var/www/kithmoot
		# No `browse`: the page links a stable filename, and a directory
		# listing is Caddy-generated HTML with inline style and script that
		# the strict CSP below would break anyway.
		file_server
	}

	handle {
		file_server
	}

	# --- headers -------------------------------------------------------
	#
	# Content-Security-Policy and Permissions-Policy are set by two blocks
	# with *disjoint* matchers, never by a base block that a later one
	# overrides. A base `header` block containing `-Server` or a `?` set is
	# deferred by Caddy to response-write time, so it runs after every
	# matched block regardless of where it sits in this file - and would
	# quietly put the marketing page's `default-src 'none'` back on the app,
	# which loads as a blank page with the camera disabled. Disjoint
	# matchers make that failure impossible rather than merely unlikely.

	# The page headers and the APK caching are shared with kithmoot.app;
	# see the kithmoot_pages snippet at the top of this file.
	import kithmoot_pages


	@app {
		path /j /j/*
		not path /j/girnel/*
	}
	header @app {
		# KithMoot is a WebRTC application. camera, microphone and
		# display-capture have to be granted to this origin or getUserMedia
		# and getDisplayMedia fail before any of the rest of it matters -
		# and they fail quietly, which is the worst kind.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		# Derived from what app/src/main.ts actually does, and no wider:
		#
		#   script-src 'self' 'wasm-unsafe-eval' - one bundled module, no
		#     inline script, and the pinned protocol modules use WebAssembly
		#     served from this origin (app/vite.config.ts). Without
		#     'wasm-unsafe-eval' the browser refuses to compile them.
		#     There is no narrower
		#     grant: 'wasm-unsafe-eval' is CSP's only switch for WASM, and
		#     the modules it admits still come only from 'self'.
		#   style-src ... 'unsafe-inline' - signet-login builds its signer
		#     picker by creating a <style> element and setting cssText
		#     (node_modules/signet-login/dist/modal.js). Without this the
		#     sign-in modal renders unstyled. Nothing in this repo needs it.
		#   img-src ... https: - a kind-0 profile picture is an arbitrary
		#     URL belonging to whoever published it (app/src/profiles.ts).
		#   connect-src ... wss: - relays. A room carries its own relay
		#     list in the join link, so no fixed list can be right here.
		#     https: is for the TURN credential endpoint above.
		#   media-src ... blob: mediastream: - remote tracks are attached
		#     by srcObject, which CSP does not police, but the QR canvas
		#     and any future recording path do go through URLs.
		#   worker-src 'self' - the service worker at /j/sw.js.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: mediastream:; connect-src 'self' wss: https:; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	}

	# The pinned Girnel editor is framed only by this same-origin workspace.
	@boards path /j/girnel/*
	header @boards {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss: https:; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), display-capture=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
	}

	# --- caching -------------------------------------------------------

	# Everything under /j/assets/ is content-hashed by the Vite build, so
	# the filename changes whenever the bytes do.
	@immutable path /j/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# A cached sw.js is a cached old version of the whole app that can
	# never see the new one, because the old worker is the thing that
	# decides whether to fetch a replacement. index.html carries the hashed
	# asset URLs for the current build and needs the same treatment.
	@noCache path /j/sw.js /j/index.html /j/ /j /j/manifest.webmanifest
	header @noCache Cache-Control "no-cache, no-store, must-revalidate"


	# No access logs, matching every other conf.d drop-in on this box
	# (cambium, flock, farrier-kit, heartwood, meatchat) and matching what
	# the page claims: a relay carrying a room cannot read its guest list,
	# and the host serving the page keeps no record of who asked for it.
	#
	# It also avoids a trap. `sudo caddy validate` runs as root and creates
	# any log file the config names, owned by root; the caddy user then
	# cannot open it and every subsequent reload fails with a permission
	# error on a file nobody remembers creating.
	log {
		output discard
	}
}

# The website. /j goes to the app where it lives (302: it is expected to
# move); the browser carries the #invitation through the redirect.
kithmoot.app {
	root * /var/www/kithmoot/current
	encode zstd gzip

	@app path /j /j/*
	redir @app https://kithmoot.forgesworn.dev{uri} 302
	@cameraLab path /camera-lab /camera-lab/*
	redir @cameraLab https://kithmoot.forgesworn.dev{uri} 302

	# Meeting code links, kithmoot.app/c/ABC-DEF-GH: 302 to the app, which
	# reads `c` from the query and asks the code service (on
	# kithmoot.forgesworn.dev, above). The app canonicalises and validates;
	# this only refuses to forward anything that is not code-shaped, so no
	# path text but alphabet symbols and hyphens reaches the Location
	# header. Anything else under /c/ falls through to the file server's
	# 404. no-store, because this host is behind Cloudflare and a cached
	# redirect would outlive the code. `redir` sorts ahead of `handle` in
	# Caddy's directive order, so this wins over the handlers below, and
	# the snippet's `?Cache-Control` sets only when absent.
	@code path_regexp code ^/c/([0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{3}-?[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{3}-?[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{2})$
	header @code Cache-Control "no-store"
	redir @code https://kithmoot.forgesworn.dev/j/?c={re.code.1} 302

	handle /apk/* {
		root * /var/www/kithmoot
		file_server
	}

	handle {
		file_server
	}

	import kithmoot_pages

	log {
		output discard
	}
}

www.kithmoot.app {
	redir https://kithmoot.app{uri} 301
	log {
		output discard
	}
}

# A second, loopback-only site: a read-only front onto kithmoot-blossom for
# wildbloomd replica nodes to fetch and verify attachment blobs over Tor.
# An explicit address (not a hostname) is its own site definition in Caddy's
# syntax, so this issues no certificate and answers no clearnet request -
# only the box's Tor hidden service (torrc.d/kithmoot-blossom-archive.conf,
# HiddenServicePort 80 127.0.0.1:8093) ever reaches it.
#
# GET and HEAD only, on a bare 64-hex-character hash at the root - the exact
# shape a replica policy's origin must serve, since wildbloomd's coordinator
# refuses any origin with a path (Profile::accepts in
# wildbloom-node/crates/wildbloomd/src/replicas/transport.rs). No /upload,
# no /mirror, no /list, no media type or extension suffix: this front cannot
# write to kithmoot-blossom and cannot be asked to enumerate what it holds.
#
# A site address's host is a Host-header match, not a bind address - Tor
# sends the onion hostname in Host, never 127.0.0.1, so a host here would
# silently answer every real request empty (confirmed: Caddy's implicit
# fallback for an unmatched Host on this listener is 200 with no body,
# not 404). A bare port matches any Host on the bound listener.
# `bind` is what keeps this off the network; UFW has no rule for 8093
# either, so unauthenticated reads would otherwise reach the public IP.
:8093 {
	bind 127.0.0.1
	@blossomArchiveBlob {
		path_regexp ^/[0-9a-f]{64}$
		method GET HEAD
	}
	handle @blossomArchiveBlob {
		reverse_proxy 127.0.0.1:8092
	}
	handle {
		respond 404
	}
	log {
		output discard
	}
}
